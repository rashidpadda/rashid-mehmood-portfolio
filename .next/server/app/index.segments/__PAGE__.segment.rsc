e:["$","section",null,{"id":"about","className":"py-24 px-6 sm:px-10","children":["$","div",null,{"className":"max-w-4xl mx-auto text-center","children":[["$","span",null,{"className":"inline-block px-4 py-1.5 rounded-full bg-accent-soft text-accent text-sm font-semibold mb-6","children":"About Me"}],["$","p",null,{"className":"text-lg sm:text-xl text-ink-soft leading-relaxed whitespace-pre-line","children":"Senior Full Stack Software Engineer with 6+ years of experience designing and building scalable enterprise applications, high-volume data systems, and integrated platforms for global markets. Strong expertise in Node.js, NestJS, React.js, Next.js, React Native, and TypeScript, with hands-on experience in microservices architecture, RESTful API design, API gateways, event-driven systems, data pipelines, and real-time processing. Proven track record designing system integrations, caching and messaging layers, and production-grade CI/CD pipelines for large-scale transactional and distributed systems. Experienced in Web3, DeFi, NFT platforms, and smart contract integrations, as well as IT infrastructure, network administration, and VoIP telephony systems. Comfortable working with distributed, cross-functional, and international teams in Agile/Scrum environments."}]]}]}]
f:["$","section",null,{"id":"experience","className":"py-24 px-6 sm:px-10 bg-bg-soft","children":["$","div",null,{"className":"max-w-4xl mx-auto","children":[["$","div",null,{"className":"text-center mb-14","children":[["$","span",null,{"className":"inline-block px-4 py-1.5 rounded-full bg-accent-soft text-accent text-sm font-semibold mb-4","children":"Experience"}],["$","h2",null,{"className":"font-display text-3xl sm:text-4xl font-extrabold text-ink","children":"Where I've worked"}]]}],["$","div",null,{"className":"flex flex-col gap-6","children":[["$","div","softbuilders",{"className":"card p-7 sm:p-8 relative overflow-hidden","children":[["$","span",null,{"className":"absolute left-0 top-0 bottom-0 w-1.5 rounded-l-2xl bg-accent"}],["$","div",null,{"className":"flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 mb-1","children":[["$","div",null,{"children":[["$","h3",null,{"className":"font-display text-xl font-bold text-ink","children":"Senior Full Stack Software Developer"}],["$","div",null,{"className":"flex flex-wrap items-baseline gap-x-3 mt-1","children":[["$","span",null,{"className":"text-accent font-semibold","children":"SoftBuilders Software Design LLC"}],["$","span",null,{"className":"text-ink-faint text-sm","children":"Business Bay, Dubai, UAE"}]]}]]}],["$","span",null,{"className":"tabular font-mono text-xs px-3 py-1.5 rounded-full bg-bg-soft border border-line text-ink-faint whitespace-nowrap","children":["01/2024"," – ","Present"]}]]}],["$","p",null,{"className":"text-ink-soft text-sm italic my-4 leading-relaxed","children":"Web3-based staking and rewards platform built with React.js, Node.js, and MongoDB, supporting decentralized licensing, machine connectivity, and high-volume user activity."}],["$","ul",null,{"className":"bullet-list space-y-2.5 mt-4","children":[["$","li","0",{"className":"text-ink text-[15px] leading-relaxed","children":"Architected and developed the core platform and admin dashboard using React.js and Node.js, supporting decentralized staking, rewards generation, and licence management."}],["$","li","1",{"className":"text-ink text-[15px] leading-relaxed","children":"Gained experience building enterprise asset-centric platforms involving equipment management, licensing, machine connectivity, and operational workflows."}],["$","li","2",{"className":"text-ink text-[15px] leading-relaxed","children":"Designed and implemented RESTful APIs and microservices that manage assets, users, permissions, workflows, and system events, aligning with Maximo-style backend architectures."}],["$","li","3",{"className":"text-ink text-[15px] leading-relaxed","children":"Designed and maintained a centralized API Gateway for routing, authentication, authorization, and rate limiting across distributed microservices."}],["$","li","4",{"className":"text-ink text-[15px] leading-relaxed","children":"Built scalable microservices for high-volume data processing and real-time workflows, improving system reliability and performance under high user concurrency."}],["$","li","5",{"className":"text-ink text-[15px] leading-relaxed","children":"Designed and implemented data processing pipelines for handling large-scale transactional data, including validation, transformation, and integration across services."}],["$","li","6",{"className":"text-ink text-[15px] leading-relaxed","children":"Developed modular React UI components for enterprise, asset-centric dashboards."}],["$","li","7",{"className":"text-ink text-[15px] leading-relaxed","children":"Implemented Redis caching, RabbitMQ messaging, webhooks, and batch processing to support millions of transactions and users."}],["$","li","8",{"className":"text-ink text-[15px] leading-relaxed","children":"Developed role-based access control (RBAC) dashboards with real-time data visualization and multi-level permissions."}],"$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28"]}]]}],"$L29","$L2a","$L2b"]}]]}]}]
